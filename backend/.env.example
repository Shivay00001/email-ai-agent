DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/email_agent

# Webhook Security
SENDGRID_WEBHOOK_KEY=your_sendgrid_webhook_verification_public_key

# SMTP Outbound Settings (e.g. SendGrid, Mailgun, or standard SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM_EMAIL=ai-assistant@yourdomain.com

# AI Credentials
OPENAI_API_KEY=your_openai_key
