# Email AI Agent — environment configuration
# Copy to .env and fill in real values. Never commit a filled .env to git.
# (Dummy placeholder values below are NOT valid credentials.)

# --- REQUIRED ---------------------------------------------------------------
# Shared secret protecting all /api/* dashboard endpoints (X-API-Key header).
# Generate one:  openssl rand -hex 32
API_KEY=REPLACE_WITH_RANDOM_HEX

# --- Database ---------------------------------------------------------------
# SQLite (default, zero-setup) or Postgres for production, e.g.:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/email_ai_agent
DATABASE_URL=sqlite+aiosqlite:///./email.db

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API with credentials.
# For local dev with the Next.js dashboard on :3000, keep the default.
CORS_ORIGINS=http://localhost:3000

# --- LLM provider keys (pick at least one) ----------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZHIPUAI_API_KEY=
# Which model litellm calls for draft generation, e.g. gpt-4o,
# claude-3-5-sonnet-20240620, gemini/gemini-1.5-pro, zhipu/glm-4
LLM_PROVIDER=gpt-4o

# --- SendGrid inbound webhook -----------------------------------------------
# Public key from SendGrid Mail Settings -> Event Webhook (ECDSA key pair).
# When set, /webhook/email REQUIRES a valid Twilio-Email signature.
SENDGRID_WEBHOOK_KEY=

# --- Outbound SMTP ----------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=agent@localhost
