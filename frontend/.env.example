# Frontend env (Next.js). Copy to .env.local for local dev.
# URL of the FastAPI backend (see backend server.py).
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Must match the backend's API_KEY env var (backend /.env). This is a
# shared secret embedded in the dashboard build — only host the dashboard
# where you trust the viewers.
NEXT_PUBLIC_API_KEY=REPLACE_WITH_SAME_VALUE_AS_BACKEND_API_KEY
